# VITE_API_BASE：后端 HTTP 根，留空 = 同源
# VITE_WS_URL：后端 WebSocket 全 URL，留空 = 由 VITE_API_BASE 推导
# VITE_DEFAULT_LANG：默认语言（zh-CN）
# VITE_DEV_WS_URL：开发模式本地后端 WS（仅 import.meta.env.DEV 生效）
# VITE_MOCK=1：开发期 mock，不连后端预览主界面（登录各 tab 返回假会话）
# VITE_VAPID_PUBLIC_KEY：Web Push VAPID 公钥（缺省不启用推送、不报错）
# VITE_CALL_ENABLED=false：关闭通话入口（默认开启）
