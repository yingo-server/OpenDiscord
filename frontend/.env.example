# 前端环境变量模板（复制为 .env.production / .env.development 后按部署填写）
# 本文件是示例，实际 env 不入库（.gitignore 已排除 .env.*）

# HTTP API 根。同域部署：留空 → 同源 location.origin
# 跨域部署：填写后端完整地址，例如 https://chat.example.com
VITE_API_BASE=

# WebSocket 全 URL。留空 → 由 API_BASE 推导（https→wss）
# 同域部署可留空；显式写法示例：wss://chat.example.com/ws
VITE_WS_URL=

# Web Push VAPID 公钥（Base64URL）。由部署方分发；留空则推送入口不可用
VITE_VAPID_PUBLIC_KEY=
